{
  "name": "kms",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:theme": "node packages/theme/build.mjs",
    "build:public": "vite build --config apps/public/vite.config.ts",
    "build:headers": "node scripts/copy-asset-headers.mjs",
    "build:admin": "npm run build -w apps/admin",
    "build": "npm run build:theme && npm run build:public && npm run build:admin && npm run build:headers",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project ui",
    "test:workers": "vitest run --project workers",
    "dev": "npm run build && wrangler dev",
    "dev:kms2": "npm run build && wrangler dev --port 8788 --inspector-port 9230",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply kms --local",
    "migrate:remote": "wrangler d1 migrations apply kms --remote",
    "seed:local": "wrangler d1 execute kms --local --file packages/db/seed/seed.sql",
    "seed:remote": "wrangler d1 execute kms --remote --file packages/db/seed/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "hono": "4.13.1",
    "preact": "10.29.8",
    "preact-render-to-string": "6.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "5.20260808.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.2.0",
    "jsdom": "^26.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "vitest-axe": "^0.1.0",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  }
}
